#!/bin/bash

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

DOWNLOAD_DIR="$HOME/storage/downloads"
mkdir -p "$DOWNLOAD_DIR"

show_help() {
    echo -e "${CYAN}vtool${NC} - Video/YouTube downloader"
    echo ""
    echo "Usage:"
    echo "  vtool                   Interactive menu"
    echo "  vtool <URL>            Download best video directly"
    echo "  vtool -h|--help        Show this help"
    echo ""
    echo "Downloads the best quality MP4 video or MP3 audio from YouTube"
    echo "and any other site supported by yt-dlp."
    echo ""
    echo "All downloads go to: $DOWNLOAD_DIR"
    exit 0
}

[ "$1" = "-h" ] || [ "$1" = "--help" ] && show_help

if [ -n "$1" ]; then
    echo -e "${YELLOW}-> Downloading best video...${NC}"
    yt-dlp -f "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/b" -P "$DOWNLOAD_DIR" "$1"
    exit $?
fi

while true; do
    clear
    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}       VTOOL - Video Downloader         ${NC}"
    echo -e "${CYAN}========================================${NC}"
    echo ""
    echo " 1) Download best video (MP4)"
    echo " 2) Download audio only (MP3)"
    echo " 3) Download entire playlist (audio)"
    echo " 4) List all resolutions then pick"
    echo " 5) Quick loop mode - paste URLs non-stop"
    echo " 6) Exit"
    echo ""
    read -p "Choice [1-6]: " CHOICE
    echo ""

    case $CHOICE in
        1)
            read -p "URL: " URL
            [ -n "$URL" ] && yt-dlp -f "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/b" -P "$DOWNLOAD_DIR" "$URL"
            read -p "Press Enter..."
            ;;
        2)
            read -p "URL: " URL
            [ -n "$URL" ] && yt-dlp -x --audio-format mp3 --audio-quality 0 -P "$DOWNLOAD_DIR" "$URL"
            read -p "Press Enter..."
            ;;
        3)
            read -p "Playlist URL: " URL
            [ -n "$URL" ] && yt-dlp -x --audio-format mp3 --yes-playlist -P "$DOWNLOAD_DIR" "$URL"
            read -p "Press Enter..."
            ;;
        4)
            read -p "URL: " URL
            if [ -n "$URL" ]; then
                yt-dlp -F "$URL"
                echo ""
                read -p "Enter format ID: " FID
                [ -n "$FID" ] && yt-dlp -f "$FID" -P "$DOWNLOAD_DIR" "$URL"
            fi
            read -p "Press Enter..."
            ;;
        5)
            echo -e "${GREEN}Quick loop mode - paste URLs, press Enter to download${NC}"
            echo -e "${RED}Enter blank line to exit${NC}"
            echo ""
            while true; do
                echo -e "${GREEN}────────────────────────${NC}"
                read -p "URL: " URL
                [ -z "$URL" ] && break
                yt-dlp -f "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4]/b" -P "$DOWNLOAD_DIR" "$URL"
                echo -e "${GREEN}Done${NC}"
            done
            ;;
        6) exit 0 ;;
        *)
            echo -e "${RED}Invalid choice${NC}"
            read -p "Press Enter..."
            ;;
    esac
done
