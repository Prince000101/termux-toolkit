#!/usr/bin/env python3
import urllib.request
import urllib.parse
import json
import os
import subprocess
import sys

C, G, Y, R, NC = "\033[1;36m", "\033[1;32m", "\033[1;33m", "\033[1;31m", "\033[0m"
DOWNLOAD_DIR = os.path.expanduser("~/storage/downloads")

def show_help():
    print(f"{C}ttget{NC} - Movie torrent downloader")
    print("")
    print("Usage:")
    print("  ttget                    Interactive search")
    print("  ttget \"movie name\"      Search and download directly")
    print("  ttget -h|--help          Show this help")
    print("")
    print("Searches YTS for movies and downloads via aria2 magnet links.")
    print("You pick the movie, then pick the quality (720p, 1080p, etc.).")
    print("")
    print(f"Downloads to: {DOWNLOAD_DIR}")
    print("")
    print(f"{Y}Tip: If you get timeouts, use a VPN or Cloudflare WARP.{NC}")
    sys.exit(0)

if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
    show_help()

query = " ".join(sys.argv[1:]) if len(sys.argv) > 1 else ""

os.system('clear')
print(f"{C}========================================{NC}")
print(f"{G}       TGET - Movie Torrent Downloader   {NC}")
print(f"{C}========================================{NC}\n")

if not query:
    query = input(f"{Y}Enter the Movie you want to download: {NC}")
if not query:
    sys.exit()

safe_query = urllib.parse.quote(query)
url = f"https://yts.mx/api/v2/list_movies.json?query_term={safe_query}"

try:
    req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
    data = json.loads(urllib.request.urlopen(req).read().decode('utf-8'))
except Exception as e:
    print(f"{R}Error: {e}{NC}")
    print(f"{Y}Tip: Timeout? Use a VPN or Cloudflare WARP.{NC}")
    sys.exit(1)

movies = data.get('data', {}).get('movies', [])
if not movies:
    print(f"{R}No movies found for '{query}'.{NC}")
    sys.exit()

for i, m in enumerate(movies[:10]):
    print(f" [{i+1}] {m.get('title')} ({m.get('year')})")

choice = input(f"\n{Y}Select movie (1-{len(movies[:10])}): {NC}")
if not (choice.isdigit() and 1 <= int(choice) <= len(movies[:10])):
    sys.exit()

selected = movies[int(choice) - 1]
torrents = selected.get('torrents', [])

if not torrents:
    print(f"{R}No torrents available for this movie.{NC}")
    sys.exit()

for j, t in enumerate(torrents):
    print(f" [{j+1}] {t.get('quality')} ({t.get('size')})")

q_choice = input(f"\n{Y}Select quality: {NC}")
if not (q_choice.isdigit() and 1 <= int(q_choice) <= len(torrents)):
    sys.exit()

hash_code = torrents[int(q_choice) - 1]['hash']
magnet = f"magnet:?xt=urn:btih:{hash_code}&dn={urllib.parse.quote(selected['title'])}"

os.makedirs(DOWNLOAD_DIR, exist_ok=True)
os.chdir(DOWNLOAD_DIR)
print(f"{G}Downloading to {DOWNLOAD_DIR}...{NC}")
subprocess.run(["aria2c", "--seed-time=0", magnet])
