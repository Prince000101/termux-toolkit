#!/bin/bash

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

DOWNLOAD_DIR="$HOME/storage/downloads/Music"
mkdir -p "$DOWNLOAD_DIR"

show_help() {
    echo -e "${CYAN}tsopt${NC} - Spotify music downloader"
    echo ""
    echo "Usage:"
    echo "  tsopt                   Interactive menu"
    echo "  tsopt <URL>            Download track/album/playlist directly"
    echo "  tsopt -h|--help        Show this help"
    echo ""
    echo "Downloads songs from Spotify by finding matching audio on YouTube,"
    echo "then embeds full metadata (title, artist, album art, lyrics)."
    echo ""
    echo "Supports:"
    echo "  - Individual tracks"
    echo "  - Albums"
    echo "  - Playlists"
    echo "  - Liked songs (tsopt with --user-auth)"
    echo ""
    echo "Downloads to: $DOWNLOAD_DIR"
    exit 0
}

[ "$1" = "-h" ] || [ "$1" = "--help" ] && show_help

if ! command -v spotdl &>/dev/null; then
    echo -e "${RED}spotDL is not installed.${NC}"
    echo -e "${YELLOW}Install: pip install spotdl${NC}"
    echo -e "${YELLOW}Or run: curl -L https://raw.githubusercontent.com/spotDL/spotify-downloader/master/scripts/termux.sh | sh${NC}"
    exit 1
fi

if [ -n "$1" ]; then
    spotdl "$1" --output "$DOWNLOAD_DIR"
    exit $?
fi

while true; do
    clear
    echo -e "${CYAN}========================================${NC}"
    echo -e "${GREEN}     TSOPT - Spotify Music Downloader    ${NC}"
    echo -e "${CYAN}========================================${NC}"
    echo ""
    echo " 1) Download song / album / playlist"
    echo " 2) Quick loop mode (keep pasting URLs)"
    echo " 3) Exit"
    echo ""
    read -p "Choice [1-3]: " CHOICE

    case $CHOICE in
        1)
            read -p "Spotify URL: " URL
            [ -n "$URL" ] && spotdl "$URL" --output "$DOWNLOAD_DIR"
            read -p "Press Enter..."
            ;;
        2)
            echo -e "${YELLOW}Paste Spotify URLs (blank line to exit):${NC}"
            while true; do
                read -p "URL: " URL
                [ -z "$URL" ] && break
                spotdl "$URL" --output "$DOWNLOAD_DIR"
                echo -e "${GREEN}Done${NC}"
            done
            ;;
        3) exit 0 ;;
        *)
            read -p "Invalid. Press Enter..."
            ;;
    esac
done
