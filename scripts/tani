#!/bin/bash

CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

DOWNLOAD_DIR="$HOME/storage/downloads/Anime"
mkdir -p "$DOWNLOAD_DIR"

export ANI_CLI_DOWNLOAD_DIR="$DOWNLOAD_DIR"

show_help() {
    echo -e "${CYAN}tani${NC} - Anime downloader & streamer"
    echo ""
    echo "Usage:"
    echo "  tani                    Interactive search"
    echo "  tani \"name\"           Search and play"
    echo "  tani -d \"name\"        Search and download"
    echo "  tani -c                Continue watching from history"
    echo "  tani -h|--help         Show this help"
    echo ""
    echo "Powered by ani-cli. Supports streaming and batch downloads."
    echo "Use -d flag to download episodes instead of streaming."
    echo "Use -e flag to specify episodes (e.g. -e 1-10)."
    echo ""
    echo "Downloads to: $DOWNLOAD_DIR"
    exit 0
}

[ "$1" = "-h" ] || [ "$1" = "--help" ] && show_help

if ! command -v ani-cli &>/dev/null; then
    echo -e "${RED}ani-cli is not installed.${NC}"
    echo -e "${YELLOW}Install: pkg install ani-cli${NC}"
    exit 1
fi

if [ -n "$1" ]; then
    ani-cli "$@"
    exit $?
fi

clear
echo -e "${CYAN}========================================${NC}"
echo -e "${GREEN}      TANI - Anime Downloader           ${NC}"
echo -e "${CYAN}========================================${NC}"
echo ""
echo -e "${YELLOW}Usage:${NC}"
echo "  tani \"anime name\"       Search and watch"
echo "  tani -d \"name\"          Search and download"
echo "  tani -c                  Continue watching"
echo ""
read -p "Enter anime name: " NAME
[ -n "$NAME" ] && ani-cli "$NAME"
